        </mxCell>
        <mxCell id="3EfQPHLub27MoszdtYXH-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a00ff;strokeColor=#3700CC;fontColor=#ffffff;align=left;spacing=10;" value="&lt;div&gt;Риски: Потеря данных, искажение данных.&lt;/div&gt;&lt;div&gt;Оценка рисков: Средний риск.&lt;/div&gt;&lt;div&gt;&lt;br&gt;Возможный доступ через CRM менеджерами, которые могут случайно или намеренно изменить данные. Взлом Web приложения может привести к утрате данных.&lt;/div&gt;" vertex="1">
          <mxGeometry height="133" width="278" x="770" y="-211" as="geometry" />
        </mxCell>
        <mxCell id="3EfQPHLub27MoszdtYXH-31" edge="1" parent="1" source="3EfQPHLub27MoszdtYXH-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="3EfQPHLub27MoszdtYXH-30">
