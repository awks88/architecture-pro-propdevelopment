        <mxCell id="3EfQPHLub27MoszdtYXH-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#ffffff;" value="Информация об объектах для Онлайн-тура" vertex="1">
